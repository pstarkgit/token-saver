#!/usr/bin/env python3
"""Start the Headroom proxy in the foreground with the kit's safety settings.

Off by default: it refuses to run without --enable-unverified, because the
Bedrock route has not been proven end to end (see
skill/references/headroom.md). For Claude Code and Codex only; the Kiro
harnesses cannot route through a proxy.

What it enforces, from the token-saver audit (AUDIT.md conditions 4 and 5):
- binds 127.0.0.1 only, passed as --host; HEADROOM_HOST and every other
  HEADROOM_* setting from the caller's environment are dropped
- HEADROOM_PROXY_TOKEN must be set (32+ characters)
- upstream is Bedrock only: --backend bedrock with an explicit region; it
  fails closed when no region is configured
- every non-Bedrock *_TARGET_API_URL points at a dead loopback port, and
  BEDROCK_TARGET_API_URL (a custom re-signing gateway) is removed
- telemetry, beacon, update check, licence reporting and model downloads off
- no CCR store, no memory, no learn, no filesystem writes (--stateless)
- AWS endpoint overrides (AWS_ENDPOINT_URL*, AWS_BEDROCK_RUNTIME_ENDPOINT,
  AWS_CONFIG_FILE), LITELLM_*, PYTHON*, WSS_PROXY and CA-bundle overrides are
  dropped, AWS_IGNORE_CONFIGURED_ENDPOINT_URLS=true is set, and the region
  must look like an AWS region name
- never runs `headroom wrap`, `init`, `install` or `learn`

It does not install Headroom, and it does not check the installed `headroom`
against the pinned commit or any hash: whoever installs Headroom owns that
step (AUDIT.md condition 6). It runs until Ctrl-C and leaves nothing behind.
"""
import argparse
import os
import re
import shutil
import sys

DEAD = "http://127.0.0.1:9"  # discard port: nothing listens, connections fail
NON_BEDROCK_URLS = ("ANTHROPIC_TARGET_API_URL", "OPENAI_TARGET_API_URL", "GEMINI_TARGET_API_URL",
                    "CLOUDCODE_TARGET_API_URL", "VERTEX_TARGET_API_URL", "FACTORY_TARGET_API_URL",
                    "OMLX_TARGET_API_URL", "HEADROOM_OMLX_BASE_URL")
DROP = ("BEDROCK_TARGET_API_URL", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "WSS_PROXY",
        "http_proxy", "https_proxy", "all_proxy", "wss_proxy",
        # endpoint and config overrides botocore and LiteLLM read
        "AWS_BEDROCK_RUNTIME_ENDPOINT", "AWS_CONFIG_FILE",
        # CA-bundle overrides that would let a local interceptor sit in the path
        "AWS_CA_BUNDLE", "REQUESTS_CA_BUNDLE", "SSL_CERT_FILE", "SSL_CERT_DIR", "CURL_CA_BUNDLE",
        "NODE_EXTRA_CA_CERTS")
DROP_PREFIXES = ("HEADROOM_", "AWS_ENDPOINT_URL", "LITELLM_", "PYTHON")
REGION = re.compile(r"^[a-z]{2}(-gov)?-[a-z]+-\d{1,2}$")
FIXED = {
    "HEADROOM_OFFLINE": "1",
    "DO_NOT_TRACK": "1",
    "HEADROOM_BEACON": "off",
    "HEADROOM_TELEMETRY": "off",
    "HEADROOM_UPDATE_CHECK": "off",
    "HEADROOM_PROXY_METRICS_REQUIRE_LOOPBACK": "true",
    "HEADROOM_BACKEND": "bedrock",
    "AWS_IGNORE_CONFIGURED_ENDPOINT_URLS": "true",
}


def build(argv, environ):
    """Return (command, env) or raise SystemExit with the reason."""
    ap = argparse.ArgumentParser(prog="headroom-guard", allow_abbrev=False)
    ap.add_argument("--enable-unverified", action="store_true",
                    help="required: acknowledges the Bedrock route is NOT VERIFIED")
    ap.add_argument("--port", type=int, default=8787)
    ap.add_argument("--region", help="Bedrock region (default: $AWS_REGION)")
    ap.add_argument("--aws-profile", help="AWS profile limited to bedrock:InvokeModel*")
    a = ap.parse_args(argv)
    if not a.enable_unverified:
        raise SystemExit("headroom-guard: Headroom is off. Its Bedrock route is NOT VERIFIED; "
                         "pass --enable-unverified to start it anyway.")
    token = environ.get("HEADROOM_PROXY_TOKEN", "")
    if len(token) < 32:
        raise SystemExit("headroom-guard: set HEADROOM_PROXY_TOKEN to a random value of 32+ characters.")
    region = a.region or environ.get("AWS_REGION")
    if not region:
        raise SystemExit("headroom-guard: no Bedrock region configured (--region or AWS_REGION); refusing to start.")
    if not REGION.match(region):
        raise SystemExit(f"headroom-guard: {region!r} is not an AWS region name; refusing to start.")
    if not 1024 <= a.port <= 65535:
        raise SystemExit("headroom-guard: --port must be 1024-65535.")
    exe = shutil.which("headroom", path=environ.get("PATH"))
    if not exe:
        raise SystemExit("headroom-guard: `headroom` is not on PATH. The kit does not install it.")
    env = {k: v for k, v in environ.items()
           if not k.startswith(DROP_PREFIXES) and k not in DROP and k not in NON_BEDROCK_URLS}
    env.update(FIXED)
    env.update({k: DEAD for k in NON_BEDROCK_URLS})
    env["HEADROOM_PROXY_TOKEN"] = token
    env["AWS_REGION"] = region
    cmd = [exe, "proxy", "--host", "127.0.0.1", "--port", str(a.port), "--backend", "bedrock",
           "--region", region, "--no-telemetry", "--no-ccr", "--stateless"]
    if a.aws_profile:
        cmd += ["--bedrock-profile", a.aws_profile]
    return cmd, env


def main():
    cmd, env = build(sys.argv[1:], dict(os.environ))
    port = cmd[cmd.index("--port") + 1]
    print(f"headroom-guard: starting {cmd[0]} on 127.0.0.1:{port}, Bedrock only, telemetry off. Ctrl-C stops it.\n"
          "  The kit has not checked this headroom install against its pinned version or hashes.\n"
          f"  Claude Code: ANTHROPIC_BASE_URL=http://127.0.0.1:{port} ANTHROPIC_AUTH_TOKEN=$HEADROOM_PROXY_TOKEN "
          "with CLAUDE_CODE_USE_BEDROCK unset.", file=sys.stderr)
    os.execve(cmd[0], cmd, env)


if __name__ == "__main__":
    main()
